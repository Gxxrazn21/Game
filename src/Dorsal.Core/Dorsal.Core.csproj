<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo del juego independiente del motor.
    - netstandard2.1 y C# 9: compatibles con Unity 6 (el DLL se copia a unity/Dorsal/Assets/Plugins).
    - No debe referenciar UnityEngine ni hacer E/S directa.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Dorsal.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity incluye Newtonsoft.Json 13.x como paquete oficial (com.unity.nuget.newtonsoft-json). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
